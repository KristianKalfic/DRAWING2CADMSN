# Agent settings (`python -m d2c.agent` and the runs from the web interface).
# Copy to .env and uncomment one variant. Values in <angle brackets> are placeholders.
# Comments are on their own lines: an env file does not strip them after a value.
# In the web interface the model is chosen per run; D2C_LLM_MODEL is then only the default for the command line.

# 1. Claude login: no key. On the machine itself the agent uses the Claude Code login.
# In the container it needs a token from `claude setup-token`.
# D2C_LLM_MODEL=sonnet
# CLAUDE_CODE_OAUTH_TOKEN=<token from claude setup-token>

# 2. Anthropic API key
# ANTHROPIC_API_KEY=<Anthropic API key>
# D2C_LLM_MODEL=sonnet

# 3. OpenRouter (Anthropic models; the URL ends without /v1)
# D2C_LLM_BASE_URL=https://openrouter.ai/api
# D2C_LLM_API_KEY=<OpenRouter API key>
# D2C_LLM_MODEL=anthropic/<model>

# 4. Ollama on the machine. The web interface lists the installed models of D2C_OLLAMA_URL
# (default http://localhost:11434, with docker compose http://host.docker.internal:11434).
# The model needs tool support and the server a context of at least 64000 tokens: OLLAMA_CONTEXT_LENGTH=64000 ollama serve
# If the server runs as an app (without OLLAMA_CONTEXT_LENGTH), a derived model with a larger context helps:
# printf 'FROM <model>\nPARAMETER num_ctx 65536\n' > /tmp/Modelfile; ollama create <model>-64k -f /tmp/Modelfile
# D2C_OLLAMA_URL=http://host.docker.internal:11434
# Command line only:
# D2C_LLM_BASE_URL=http://localhost:11434
# D2C_LLM_MODEL=<model from ollama list>

# Optional for every variant.
# A second model builds the part from the specification; the first only reads the drawing.
# D2C_LLM_BUILD_MODEL=<model>
# The MCP server: stdio (default), a URL such as http://mcp:8765/mcp or a command line.
# D2C_MCP_URL=docker run -i --rm --network none --read-only --tmpfs /tmp -v <drawings folder>:/data:ro -v <results folder>:/app/results d2c
# Logs of the server and web app on stderr: debug additionally shows every worker call.
# D2C_LOG=info
# With docker compose this .env reaches only the web app: the mcp service does not get the server variables (D2C_LOG, D2C_TIMEOUT, D2C_TABLES);
# for those an `environment:` line in the mcp service of docker-compose.yml is needed.

# Local models (Ollama): context in tokens, thinking budget per answer, build via a different endpoint.
# D2C_LLM_CONTEXT=64000
# D2C_LLM_THINKING=4000
# D2C_LLM_BUILD_BASE_URL=http://localhost:11434
# Full instead of compact report of the build tools.
# D2C_REPORT=full
# Limits per agent run (0 = off) and parallel runs of the web interface.
# D2C_MAX_USD=3
# D2C_MAX_MINUTES=20
# D2C_MAX_RUNS=2
# Host names the web interface answers to besides localhost, 127.0.0.1 and [::1] (comma separated),
# for example behind a reverse proxy. Other Host headers get a 400 (DNS rebinding protection).
# D2C_ALLOWED_HOSTS=d2c.example.com
